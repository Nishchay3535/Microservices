# Copy to secret.yaml (do not commit real values)
apiVersion: v1
kind: Secret
metadata:
  name: healthequity-secrets
  namespace: healthequity
type: Opaque
stringData:
  SECRET_KEY: "replace-with-openssl-rand-hex-32"
  DATABASE_URL: "postgresql+asyncpg://user:pass@host:5432/db"
  OPENAI_API_KEY: ""
  RESEND_API_KEY: ""
  SUPABASE_SERVICE_KEY: ""
