# Backend (copy to backend/.env)
SECRET_KEY=change-me-use-openssl-rand-hex-32
DATABASE_URL=sqlite+aiosqlite:///./healthequity.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
REDIS_URL=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=issue-attachments

# --- AI (pick one) ---
# OpenAI (paid credits): https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Groq (free tier, recommended for local dev): https://console.groq.com/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant

RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

ESCALATION_THRESHOLD_DAYS=7

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
